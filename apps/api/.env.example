# -----------------------------------------------------------------------------
# Verity API — local environment template
#
# Copy this file to `.env` in apps/api/ and fill in real values. `.env` is
# git-ignored and must never be committed. In staging/production, these
# values come from the deployment platform's managed secret store
# (Railway), never from a checked-in file — see TechStack.md §7.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# One of: local, staging, production
VERITY_ENVIRONMENT=local
VERITY_API_HOST=0.0.0.0
VERITY_API_PORT=8000

# --- Database ------------------------------------------------------------
# Matches the docker-compose.yml Milestone 1A postgres service.
VERITY_DATABASE_URL=postgresql+asyncpg://verity:verity_local_dev@localhost:5432/verity

# --- JWT access tokens -----------------------------------------------------
# Symmetric signing secret. Generate a strong local value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production uses a distinct, rotated value from the managed secret store.
VERITY_JWT_SECRET_KEY=cBia-iDFqovlHcCqI9fvlyA3crd5NjB_vMMNmTIv8qg2os5i8YIj4D1Bh_pSGMfzZd6sRT-cQWpArgw4eSCpnw
VERITY_JWT_ALGORITHM=HS256
VERITY_JWT_ACCESS_TOKEN_TTL_SECONDS=900
VERITY_JWT_ISSUER=verity-api
VERITY_JWT_AUDIENCE=verity-app

# --- Refresh session tokens --------------------------------------------------
# Opaque, high-entropy tokens; only their hash is ever persisted. Session
# persistence/rotation lands in a later task — these settings size the token
# and its lifetime for the utilities configured now.
VERITY_REFRESH_TOKEN_TTL_SECONDS=2592000
VERITY_REFRESH_TOKEN_BYTES=32

# --- Email encryption / lookup hashing --------------------------------------
# users.email_ciphertext is encrypted at rest; users.email_lookup_hash is a
# keyed, non-reversible hash used only for uniqueness/lookup (Database.md §4.1).
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VERITY_EMAIL_ENCRYPTION_KEY=fzQTcUUAQxXSp1GcMISFcFKw3scFeMxR8M_3XP3AI9g=
# Generate a hash key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
VERITY_EMAIL_HASH_KEY=4245b5a8bdc5cf68bc5342466c4ee04c2e57db5aff6b81cbaaca5c4dcab88f35

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins. No wildcards (Architecture.md §7).
VERITY_CORS_ORIGINS=http://localhost:3000